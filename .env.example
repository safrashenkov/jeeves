# Telegram
BOT_TOKEN=
BOT_NAME=
ADMIN_ID=

# Webhook (публичный адрес за nginx)
WEBHOOK_BASE_URL=https://jeeves.perm-bear.ru
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=

# Локальный адрес, на котором слушает бот (за nginx)
LISTEN_HOST=127.0.0.1
LISTEN_PORT=18090

# MariaDB (база wa)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=wa

# Опрос новостей, секунд
NEWS_INTERVAL_SECONDS=300
